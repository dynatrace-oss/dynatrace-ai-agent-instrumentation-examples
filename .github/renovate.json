{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "monorepo:opentelemetry-js"],
  "timezone": "UTC",
  "ignorePaths": ["**/.venv/**"],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|/)Makefile$/"
      ],
      "matchStrings": [
        "ghcr\\.io/dynatrace/dynatrace-otel-collector/dynatrace-otel-collector:(?<currentValue>[^\\s]+)"
      ],
      "depNameTemplate": "ghcr.io/dynatrace/dynatrace-otel-collector/dynatrace-otel-collector",
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|/)Makefile$/"
      ],
      "matchStrings": [
        "ghcr\\.io/observiq/bindplane-agent:(?<currentValue>[^\\s]+)"
      ],
      "depNameTemplate": "ghcr.io/observiq/bindplane-agent",
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "SDK versions shown in the README demo tables. Grouped with the demos' own pins below so both move in one PR.",
      "managerFilePatterns": ["/^README\\.md$/"],
      "matchStrings": [
        "(?<currentValue>\\d[^\\s|]*) <!-- renovate: datasource=(?<datasource>[a-z-]+) depName=(?<depName>[^\\s]+) -->"
      ]
    }
  ],
  "prHourlyLimit": 20,
  "lockFileMaintenance": {
    "description": "Refresh committed lockfiles on a schedule. Without this, a transitive dependency is frozen at whatever resolved when the lock was written, because renovate only ever updates *declared* constraints. That is how mcp/opentelemetry stayed on traceloop-sdk 0.47.3 while every sibling demo ran 0.62.x. It also matters after a bump lands: traceloop-sdk requires its opentelemetry-instrumentation-* packages unversioned, so moving the sdk pin alone leaves the old instrumentation resolutions in place.",
    "enabled": true,
    "schedule": ["before 6am on monday"],
    "commitMessageAction": "refresh",
    "groupName": "lockfile refresh"
  },
  "packageRules": [
    {
      "matchUpdateTypes": ["major"],
      "prConcurrentLimit": 2,
      "prPriority": -1
    },
    {
      "description": "Pin Python ranges to exact versions. A '>=' floor is satisfied by every later release, so renovate sees nothing to update and the demo silently freezes at whatever its lockfile resolved. Pinning converts any such constraint to '==' in a PR, after which every subsequent release raises one.",
      "matchManagers": ["pep621", "pip_requirements"],
      "rangeStrategy": "pin"
    },
    {
      "description": "Keep the openllmetry family moving together. traceloop-sdk and its opentelemetry-instrumentation-* packages share one version line, and demo collector configs depend on their attribute behaviour, so they should be reviewed as a single change rather than drifting apart.",
      "matchManagers": ["pep621", "pip_requirements"],
      "matchPackageNames": [
        "traceloop-sdk",
        "opentelemetry-instrumentation-**"
      ],
      "groupName": "traceloop (openllmetry)"
    },
    {
      "matchManagers": ["pip_requirements", "pep621"],
      "groupName": "python dependencies"
    },
    {
      "matchManagers": ["dockerfile"],
      "groupName": "docker base images"
    },
    {
      "matchManagers": ["github-actions"],
      "groupName": "github actions"
    },
    {
      "matchManagers": ["github-actions"],
      "matchDepNames": ["python"],
      "allowedVersions": "<3.14",
      "groupName": "python runtime"
    },
    {
      "matchManagers": ["gomod"],
      "groupName": "go modules"
    },
    {
      "matchManagers": ["custom.regex"],
      "matchDepNames": [
        "ghcr.io/dynatrace/dynatrace-otel-collector/dynatrace-otel-collector",
        "ghcr.io/observiq/bindplane-agent"
      ],
      "groupName": "collector image"
    },
    {
      "matchManagers": ["npm"],
      "matchFileNames": ["langfuse/opentelemetry-node/**"],
      "groupName": "npm dependencies (langfuse)"
    },
    {
      "matchManagers": ["npm"],
      "matchFileNames": ["rum/opentelemetry/nextjs-frontend/**"],
      "groupName": "npm dependencies (rum)"
    },
    {
      "matchManagers": ["npm"],
      "matchFileNames": ["mcp/opentelemetry/mpc-server/**"],
      "groupName": "npm dependencies (mcp)"
    },
    {
      "matchManagers": ["npm"],
      "matchFileNames": ["ai-coding-agents/openclaw-observability-plugin/otel-observability/**"],
      "groupName": "npm dependencies (openclaw)"
    },
    {
      "matchManagers": ["npm"],
      "matchFileNames": ["ai-coding-agents/github-copilot-sdk/**"],
      "groupName": "npm dependencies (github-copilot-sdk)"
    },
    {
      "matchManagers": ["npm"],
      "matchFileNames": ["openai-agents/opentelemetry/ui/**"],
      "groupName": "npm dependencies (openai-agents)"
    },
    {
      "description": "One PR per main demo SDK covering every demo and the README table, so all examples stay on the same version. Must come after the generic python group to override its groupName; separateMajorMinor off so demos on an older major still land in the same PR.",
      "matchDatasources": ["pypi"],
      "matchPackageNames": [
        "openai",
        "anthropic",
        "boto3",
        "cohere",
        "groq",
        "mistralai",
        "ollama",
        "strands-agents",
        "crewai",
        "google-adk",
        "haystack-ai",
        "langfuse",
        "langgraph",
        "litellm",
        "agent-framework",
        "openai-agents",
        "pydantic-ai"
      ],
      "groupName": "{{depName}} sdk",
      "separateMajorMinor": false
    },
    {
      "description": "Converting '>=' floors to exact pins is a one-time step per dependency. Pin updates don't expand the templated groupName above, so give them their own group.",
      "matchDatasources": ["pypi"],
      "matchUpdateTypes": ["pin"],
      "groupName": "pin sdk versions",
      "matchPackageNames": [
        "openai",
        "anthropic",
        "boto3",
        "cohere",
        "groq",
        "mistralai",
        "ollama",
        "strands-agents",
        "crewai",
        "google-adk",
        "haystack-ai",
        "langfuse",
        "langgraph",
        "litellm",
        "agent-framework",
        "openai-agents",
        "pydantic-ai"
      ]
    },
    {
      "matchDatasources": ["npm"],
      "matchPackageNames": ["@github/copilot-sdk"],
      "groupName": "@github/copilot-sdk",
      "separateMajorMinor": false
    },
    {
      "matchDatasources": ["npm"],
      "matchPackageNames": ["@modelcontextprotocol/sdk"],
      "groupName": "@modelcontextprotocol/sdk",
      "separateMajorMinor": false
    },
    {
      "description": "anthropic 1.x moved to httpx2; the OneAgent and OpenInference anthropic demos stop producing gen_ai spans on it. Stay on 0.x until both support 1.x.",
      "matchDatasources": ["pypi"],
      "matchPackageNames": ["anthropic"],
      "allowedVersions": "<1.0.0"
    },
    {
      "description": "litellm.proxy imports fastapi.dependencies.utils.get_flat_dependant, removed in FastAPI 0.140.7. Keep renovate below it until litellm drops that import.",
      "matchManagers": ["pep621"],
      "matchFileNames": ["litellm/opentelemetry/**"],
      "matchDepNames": ["fastapi"],
      "allowedVersions": "<0.140.7"
    }
  ]
}
