# AWS credentials -- only needed when MOCK_AGENTCORE=false
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# ARN of the AgentCore harness to invoke, e.g.
# arn:aws:bedrock-agentcore:us-east-1:123456789012:harness/my-harness-AbCdEfGhIj
HARNESS_ARN=

# Set to true to run this demo without AWS credentials or a deployed harness.
# Exercises the exact same instrumentation code path (span + metrics + trace
# context propagation) against an in-process fake stream shaped like a real
# InvokeHarness response.
MOCK_AGENTCORE=true

# Used both as the FastAPI title (for OneAgent's Smartscape service.name) and
# as the span/metric "service" dimension. The span itself needs no exporter or
# token -- see the README's "Dynatrace prerequisites" section (OneAgent's
# "OpenTelemetry (Python)" feature must be enabled, or the span is silently
# dropped). The two lines below are for metrics only.
OTEL_SERVICE_NAME=aws-bedrock-agentcore-example
OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=https://<YOUR_ENV_ID>.live.dynatrace.com/api/v2/otlp/v1/metrics
DT_API_TOKEN=
