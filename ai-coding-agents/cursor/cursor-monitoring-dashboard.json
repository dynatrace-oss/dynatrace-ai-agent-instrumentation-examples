    "table": {
      "title": "Request tokens by model",
      "type": "data",
      "query": "fetch logs\n| filter `service.name` == \"cursor\"\n| filter (`event.name` == \"cursor.api.request\" or content == \"api_request\")\n| fieldsAdd Input = toLong(cursor.api.request.input_tokens), Output = toLong(cursor.api.request.output_tokens), CacheRead = toLong(cursor.api.request.cache_read_tokens), CacheCreation = toLong(cursor.api.request.cache_creation_tokens)\n| summarize InputTokens = sum(Input), OutputTokens = sum(Output), CacheReadTokens = sum(CacheRead), CacheCreationTokens = sum(CacheCreation), by: {cursor.model.name}\n| sort InputTokens desc",
      "visualization": "table",
      "visualizationSettings": {
        "autoSelectVisualization": false
      },
      "querySettings": {
        "maxResultRecords": 1000,
        "defaultScanLimitGbytes": 500,
        "maxResultMegaBytes": 100,
