    "msg": {
      "title": "Conversation messages (opt-in)",
      "type": "data",
      "query": "fetch logs\n| filter `service.name` == \"cursor\"\n| filter `event.name` == \"cursor.conversation.user_message\" or `event.name` == \"cursor.conversation.assistant_message\" or `event.name` == \"cursor.conversation.tool_io\"\n| fields timestamp, `event.name`, cursor.conversation.id, cursor.conversation.turn.id, cursor.conversation.content_truncated, content\n| sort timestamp desc\n| limit 100",
      "visualization": "table",
      "visualizationSettings": {
        "autoSelectVisualization": false
      },
      "querySettings": {
        "maxResultRecords": 1000,
        "defaultScanLimitGbytes": 500,
