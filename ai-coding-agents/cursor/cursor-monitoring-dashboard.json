  "tiles": {
    "h": {
      "type": "markdown",
      "content": "## CURSOR ENTERPRISE OTEL \u2014 LOG & METRIC ANALYTICS\nCursor exports OTLP/HTTP protobuf **logs and delta metrics, not traces**. This dashboard extracts model, token, latency, conversation, user, tool, skill, hook, and optional message-content insights."
    },
    "r": {
      "title": "API requests",
      "type": "data",
      "query": "fetch logs\n| filter `service.name` == \"cursor\"\n| filter (`event.name` == \"cursor.api.request\" or content == \"api_request\")\n| summarize Requests = count()",
      "visualization": "singleValue",
      "visualizationSettings": {
        "autoSelectVisualization": false,
        "singleValue": {
          "label": "Requests",
          "recordField": "Requests",
          "trend": {
            "isVisible": false
          },
          "sparklineSettings": {
            "isVisible": false
          }
        }
      },
      "querySettings": {
        "maxResultRecords": 1000,
        "defaultScanLimitGbytes": 500,
        "maxResultMegaBytes": 100,
        "defaultSamplingRatio": 10,
        "enableSampling": false
      },
      "davis": {
        "enabled": false,
        "davisVisualization": {
          "isAvailable": true
        }
      }
    },
