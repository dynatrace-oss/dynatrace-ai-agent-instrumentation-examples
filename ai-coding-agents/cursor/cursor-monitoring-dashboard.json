    "busy": {
      "title": "Busiest conversations by tokens",
      "type": "data",
      "query": "fetch logs\n| filter `service.name` == \"cursor\"\n| filter (`event.name` == \"cursor.api.request\" or content == \"api_request\")\n| fieldsAdd Conversation = cursor.conversation.id, InputTokens = coalesce(toLong(cursor.api.request.input_tokens), 0), OutputTokens = coalesce(toLong(cursor.api.request.output_tokens), 0)\n| summarize Requests = count(), InputTokens = sum(InputTokens), OutputTokens = sum(OutputTokens), by: {Conversation}\n| fieldsAdd TotalTokens = InputTokens + OutputTokens\n| sort TotalTokens desc\n| limit 50",
      "visualization": "table",
      "visualizationSettings": {
        "autoSelectVisualization": false
      },
      "querySettings": {
        "maxResultRecords": 1000,
        "defaultScanLimitGbytes": 500,
        "maxResultMegaBytes": 100,
        "defaultSamplingRatio": 10,
        "enableSampling": false
      },
      "davis": {
        "enabled": false,
        "davisVisualization": {
          "isAvailable": true
        }
      }
