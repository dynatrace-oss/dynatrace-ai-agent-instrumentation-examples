# Dynatrace OTLP ingestion (used by the OTel Collector, not by the agent).
# OTLP base path: classic domain + /api/v2/otlp
# Token scopes: openTelemetryTrace.ingest, metrics.ingest (classic token dt0c01.*)
DT_OTEL_ENDPOINT=https://YOUR_ENV_ID.live.dynatrace.com/api/v2/otlp
DT_API_TOKEN=dt0c01.YOUR_TOKEN_HERE

# GitHub Copilot authentication (SDK applications only; the CLI and VS Code
# use their own sign-in).
GH_TOKEN=ghp_your_github_token_here

# Where the Copilot runtime sends OTLP. Point at the local Collector.
# COPILOT_OTLP_ENDPOINT=http://localhost:4318

# Capture prompt, response, and tool content (default: false).
# This content can include source code and other sensitive data.
# COPILOT_CAPTURE_CONTENT=true

# Model used by the SDK example.
# PROVIDER_MODEL=claude-sonnet-4-5-20250929

# BYOK override: point the session at an OpenAI-compatible endpoint instead of
# the Copilot API. Used by the e2e suite to run against a mock; leave unset.
# COPILOT_PROVIDER_BASE_URL=
# COPILOT_PROVIDER_API_KEY=
