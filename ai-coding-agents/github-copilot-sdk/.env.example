# Telemetry mode: manual (default) or native.
#   manual: this example's OTel exporters + spans synthesized from session events
#   native: the Copilot runtime's own OTel export via TelemetryConfig
# Do not enable both: they double-count LLM calls and tokens.
# COPILOT_TELEMETRY_MODE=manual

# Native mode only: OTLP endpoint the Copilot runtime exports to.
# TelemetryConfig has no headers field, so use an authenticated OTLP gateway/Collector
# that forwards to Dynatrace rather than pointing this at Dynatrace directly.
# COPILOT_OTLP_ENDPOINT=https://otel-gateway.example.com

# GitHub Copilot SDK authentication
GH_TOKEN=ghp_your_github_token_here

# Dynatrace OTLP ingestion
# OTLP base path: classic domain + /api/v2/otlp
# See: https://docs.dynatrace.com/docs/ingest-from/opentelemetry/otlp-api
# Token requires scopes: openTelemetryTrace.ingest, metrics.ingest (classic token dt0c01.*)
DYNATRACE_OTLP_URL=https://YOUR_ENV_ID.live.dynatrace.com/api/v2/otlp
DYNATRACE_OTLP_TOKEN=dt0c01.YOUR_TOKEN_HERE

# Optional: service name for traces/metrics (default: copilot-sdk-agent)
# OTEL_SERVICE_NAME=copilot-sdk-agent

# Optional: capture message content in spans (default: false).
# Prompts, responses, and tool payloads can contain source code and other sensitive data.
# OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT=true
