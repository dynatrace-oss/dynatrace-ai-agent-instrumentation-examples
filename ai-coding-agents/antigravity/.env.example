# Dynatrace OTLP base URL (no signal suffix)
DT_OTEL_ENDPOINT=https://<environment-id>.live.dynatrace.com/api/v2/otlp

# API token with openTelemetryTrace.ingest and metrics.ingest scopes
DT_API_TOKEN=dt0c01.replace-me

# Gemini API key used by the Antigravity SDK (GOOGLE_API_KEY also works)
GEMINI_API_KEY=replace-me

# Optional: override the model the agent runs on (defaults to the SDK default)
# MODEL=gemini-3.8-flash

# Prompt and response capture; defaults to true, set to false to omit content
# OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT=true
