      {
        "type": "valueMetric",
        "enabled": true,
        "id": "metric_otel_input_tokens_4711",
        "description": "Emit gen_ai.client.inference.usage.input_tokens, the current OTel spec name. The spec replaced the single gen_ai.client.token.usage metric keyed by gen_ai.token.type with one counter per token kind. The legacy key is kept alongside because the AI Observability tiles still read it.",
        "matcher": "matchesValue(span.name, \"claude_code.llm_request\") and isNotNull(input_tokens)",
        "valueMetric": {
