# Dynatrace OTLP configuration for the Kiro spike's synthetic test data
# Copy this file to .env and fill in your credentials:
#   cp .env.example .env

# Dynatrace API token with metrics.ingest scope
DT_API_TOKEN=dt0c01.XXXXXXXX.XXXXXXXXXXXXXXXX

# Dynatrace OTLP endpoint (base URL, do NOT include /v1/metrics or other signal suffixes)
# SaaS production:  https://<env-id>.live.dynatrace.com/api/v2/otlp
DT_OTEL_ENDPOINT=https://<YOUR_ENV_ID>.live.dynatrace.com/api/v2/otlp
